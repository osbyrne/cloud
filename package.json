{
  "name": "contact-manager-k8s",
  "version": "1.0.0",
  "description": "A single-service contact management application in TypeScript deployed on Kubernetes",
  "main": "dist/server.js",
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "tsc",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node dist/server.js",
    "dev:backend": "nodemon --watch src -e ts --exec ts-node src/server.ts",
    "dev:frontend": "npm run dev --prefix frontend"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
