{
  "name": "contact-manager-k8s",
  "version": "1.0.0",
  "description": "A single-service contact management application in TypeScript deployed on Kubernetes",
  "main": "dist/server.js",
  "scripts": {
    "install:all": "bun install && bun install --prefix frontend",
    "build:frontend": "bun run build --prefix frontend",
    "build:backend": "tsc",
    "build": "bun run build:frontend && bun run build:backend",
    "start": "bun dist/server.js",
    "dev:backend": "nodemon --watch src -e ts --exec ts-node src/server.ts",
    "dev:frontend": "bun run dev --prefix frontend",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "nodemon": "^3.1.4",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^5.5.2"
  }
}
